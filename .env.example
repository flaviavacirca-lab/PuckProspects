# Database
DATABASE_URL=postgresql://puckprospects:puckprospects@localhost:5432/puckprospects

# Ingestion Pipeline
INGESTION_CONCURRENCY=3
INGESTION_CRON=0 */6 * * *
PIPELINE_MAX_RETRIES=1
PIPELINE_STORE_RAW=true
PIPELINE_LOG_LEVEL=info
PIPELINE_RATE_LIMIT=10
PIPELINE_REQUEST_TIMEOUT=30000

# Data source (mock = static data, live = pipeline + DB)
DATA_SOURCE=mock

# API Keys (add as connectors are built)
# AHL_API_KEY=
# EP_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
